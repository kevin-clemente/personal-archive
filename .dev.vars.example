# Copy to .dev.vars for local development (never commit real values).
PIHOLE_URL=http://pi.hole

# Pi-hole v6: create an app password under Settings → API.
PIHOLE_PASSWORD=

# Pi-hole v5 only: use the API token instead of the password.
# PIHOLE_API_TOKEN=

# Optional: override the admin link shown on the dashboard.
# PIHOLE_ADMIN_URL=http://pi.hole/admin

# Optional: force the API version when auto-detection is ambiguous.
# PIHOLE_VERSION=v6

# Required when PIHOLE_URL is behind Cloudflare Access (e.g. a Tunnel hostname).
# Create a service token under Zero Trust → Access → Service Auth, then allow it
# with a non_identity policy on the Pi-hole application.
# PIHOLE_ACCESS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.access
# PIHOLE_ACCESS_CLIENT_SECRET=cfast_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
